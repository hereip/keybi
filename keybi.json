{
  "modifier": "alt_gr",
  "repeat_delay": 0.3,
  "repeat_rate": 0.05,
  "binds": {
    "left":  { "action": "mouse_move", "dx": -10, "dy": 0,  "repeat": true },
    "right": { "action": "mouse_move", "dx":  10, "dy": 0,  "repeat": true },
    "up":    { "action": "mouse_move", "dx": 0,  "dy": -10, "repeat": true },
    "down":  { "action": "mouse_move", "dx": 0,  "dy":  10, "repeat": true },

    "a": { "action": "mouse_press", "button": "left" },
    "d": { "action": "mouse_click", "button": "right" },

    "w": { "action": "mouse_scroll", "dy": -1, "repeat": true },
    "s": { "action": "mouse_scroll", "dy":  1, "repeat": true },

    "q": { "action": "mouse_click", "button": "left" }
  }
}
